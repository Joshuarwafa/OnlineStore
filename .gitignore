# ---------- secrets: never commit ----------
.env
.env.*
!.env.example
# SageAPI keeps the Sage licence and the (protected) SQL password here, and the admin portal
# writes to it. Copy appsettings.example.json to appsettings.json on a new machine.
Backend/SageAPI/SageAPI/appsettings.json
Backend/SageAPI/SageAPI/appsettings.*.json
!Backend/SageAPI/SageAPI/appsettings.example.json

# ---------- shop data: customer details and pictures, not code ----------
# orders/ holds shoppers' names, phones and addresses
Backend/StoreBackend/data/

