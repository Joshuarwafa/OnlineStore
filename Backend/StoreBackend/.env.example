# Store backend settings. Copy to .env and fill in. Never commit .env.

PORT=4000

# SageAPI address and the shared API key (must equal SageAPI's Security:ApiKey, 32+ characters)
SAGEAPI_URL=http://localhost:5071
SAGEAPI_KEY=

# Admin sign-in: generate with  npm run hash-password
ADMIN_PASSWORD_HASH=admin

# Signs the admin session cookie (32+ random characters)
SESSION_SECRET=
SESSION_HOURS=8

# true in production (HTTPS). Set false only for local http development.
COOKIE_SECURE=true

# Sites allowed to make admin changes (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# Catalogue: which Sage price list and warehouse the store sells from (per client)
STORE_PRICE_LIST=USD-RETAIL
STORE_WAREHOUSE=2
STORE_CURRENCY=USD
CATALOGUE_REFRESH_MINUTES=5

# Walk-in shoppers' quotations and orders go on this Sage customer account (e.g. a cash-sales account).
# Normally chosen in the admin portal (Maintenance → Customers); this is only the fallback.
# STORE_CASH_CUSTOMER=

# Product pictures. Folder that holds them (default: data/images inside this folder).
# Back this folder up: it is the only copy of the pictures.
# IMAGES_DIR=C:\StoreData\images
# When the website is hosted elsewhere (e.g. Vercel), the public address of this backend,
# so picture links point here, e.g. https://api.yourstore.com. Empty = same site.
PUBLIC_IMAGE_BASE_URL=
