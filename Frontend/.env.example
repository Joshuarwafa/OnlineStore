# true  = run against the built-in mock store (no backend needed)
# false = call the store backend at /api
VITE_USE_MOCKS=true

# Go live one part at a time while VITE_USE_MOCKS=true (comma-separated):
#   catalogue = shop products, prices, stock and checkout prices come from Sage
# (The admin portal is a separate app: Backend/SageAPI/frontend.)
VITE_LIVE_FEATURES=

# Shown in the header, footer and page titles
VITE_STORE_NAME=Stockroom

# Open decisions in the scope (D5, D8). Comma-separated.
# Fulfilment: delivery, collection
VITE_FULFILMENT=delivery,collection
# Payment: on_collection, on_delivery, online
VITE_PAYMENT_METHODS=on_collection,on_delivery
VITE_COLLECTION_POINT=Our Bulawayo store

# Contact details shown in the header, footer and Contact page. Replace these placeholders.
VITE_STORE_LABEL=Bulawayo
VITE_CONTACT_PHONE=+263 29 000 0000
VITE_CONTACT_EMAIL=sales@yourstore.co.zw
VITE_STORE_ADDRESS=00 Example Street, Bulawayo
VITE_STORE_HOURS=Mon–Fri 08:00–17:00 · Sat 08:00–13:00

# Dev server only: where /api is proxied to
STORE_BACKEND_URL=http://localhost:4000
